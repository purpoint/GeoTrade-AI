{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "services/backend/Dockerfile", "watchPatterns": ["services/backend/**", "data/**"] },
  "deploy": {
    "startCommand": "backend worker",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
