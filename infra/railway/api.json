{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "services/backend/Dockerfile", "watchPatterns": ["services/backend/**", "data/**"] },
  "deploy": {
    "startCommand": "backend api",
    "preDeployCommand": ["backend migrate && backend seed --demo"],
    "healthcheckPath": "/api/v1/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
