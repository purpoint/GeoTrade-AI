# Copy to .env and fill in. Never commit .env.

# database service
POSTGRES_DB=geotrade
POSTGRES_USER=geotrade
POSTGRES_PASSWORD=geotrade-dev

# backend
DATABASE_URL=postgresql+psycopg://geotrade:geotrade-dev@localhost:5432/geotrade
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
OPERATOR_TOKEN=change-me-operator-token

# auth (Phase 2). Blank means a development default; in production set both (32+ characters): python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
REFRESH_TOKEN_PEPPER=
COOKIE_SECURE=false
# optional operator login for the admin pages (created by `backend seed --demo`)
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# LLM (Qwen 3.8 27B on Groq; Qwen3-32B was shut down on 2026-07-17). With ENABLE_LLM=false the keyword scorer is used.
ENABLE_LLM=false
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
LLM_DAILY_BUDGET=150
LLM_PER_MINUTE=5

# worker
ENABLE_PRICES=true

# Daily Pulse email (Phase 3). Local Compose sends to Mailpit (http://localhost:8025); production uses brevo.
ENABLE_DIGEST=true
ENABLE_WEEKLY_DIGEST=true
PUBLIC_WEB_URL=http://localhost:3000
DIGEST_BUILD_TIME_IST=16:30
DIGEST_DEFAULT_SEND_TIME_IST=17:00
WEEKLY_DIGEST_TIME_IST=09:00
EMAIL_PROVIDER=smtp
EMAIL_FROM=samvam0821@gmail.com
EMAIL_FROM_NAME=GeoTrade-AI Daily Pulse
EMAIL_DAILY_QUOTA=300
BREVO_API_KEY=
# 32+ characters in production; blank uses a development default
UNSUBSCRIBE_TOKEN_SECRET=
# shared with the Brevo webhook URL (?token=...); blank disables the webhook
EMAIL_WEBHOOK_SECRET=
# optional off-box copy of nightly dumps, e.g. r2:geotrade-backups (rclone config in backups/.rclone)
BACKUP_RCLONE_REMOTE=

# ui
NEXT_PUBLIC_API_BASE=/api/v1
BACKEND_URL=http://localhost:8000
# host port for the database container (change if a local Postgres already uses 5432)
POSTGRES_HOST_PORT=5432
