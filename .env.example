# Copy to .env and fill in. Never commit .env.

# database service
POSTGRES_DB=geotrade
POSTGRES_USER=geotrade
POSTGRES_PASSWORD=geotrade-dev

# backend
DATABASE_URL=postgresql+psycopg://geotrade:geotrade-dev@localhost:5432/geotrade
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
OPERATOR_TOKEN=change-me-operator-token

# LLM (Qwen3-32B on Groq). With ENABLE_LLM=false the keyword scorer is used.
ENABLE_LLM=false
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3-32b
GROQ_API_KEY=
LLM_DAILY_BUDGET=150
LLM_PER_MINUTE=30

# worker
ENABLE_PRICES=true

# ui
NEXT_PUBLIC_API_BASE=/api/v1
BACKEND_URL=http://localhost:8000
# host port for the database container (change if a local Postgres already uses 5432)
POSTGRES_HOST_PORT=5432
